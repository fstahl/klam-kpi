{
  "name": "klamkpi",
  "productName": "Kläm KPI",
  "version": "0.1.0",
  "description": "On-premise KPI dashboard for small companies.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently \"node --watch server.js\" \"vite\"",
    "electron": "npm run build && electron .",
    "start": "node server.js",
    "pull": "python3 pull_data.py",
    "test": "python3 tests/test_pull_data.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "vite": "^8.0.13"
  }
}
