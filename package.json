{
  "name": "klamkpi",
  "productName": "Kläm KPI",
  "version": "0.1.0",
  "description": "On-premise KPI dashboard for small companies.",
  "author": "Fredrik Ståhl",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently \"node --watch server.js\" \"vite\"",
    "electron": "npm run build && electron .",
    "start": "node server.js",
    "pull": "python3 pull_data.py",
    "test": "python3 tests/test_pull_data.py",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.klamkpi",
    "productName": "Kläm KPI",
    "asar": true,
    "files": [
      "dist/**",
      "public/**",
      "src/boardKpi.js",
      "src/config.js",
      "electron/**",
      "server.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data.xlsx",
        "to": "data.xlsx"
      },
      {
        "from": "kpi-config.json",
        "to": "kpi-config.json"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "dmg": {
      "title": "Kläm KPI"
    },
    "win": {
      "target": "nsis"
    },
    "afterPack": "./afterPack.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^25.1.8",
    "vite": "^8.0.13"
  }
}
