{
  "_doc": "Single source of truth for KPI fields. Both pull_data.py and src/boardKpi.js read this. Types: string | number | percent. Percent fields are stored as decimals in Excel and ×100 for display.",
  "fields": {
    "label":            { "type": "string" },
    "range":            { "type": "string" },

    "cm_count":         { "type": "number" },
    "cm_value":         { "type": "number" },
    "cm_delta":         { "type": "percent" },

    "pe_count":         { "type": "number" },
    "pe_value":         { "type": "number" },
    "pe_delta":         { "type": "percent" },

    "revenue":          { "type": "number" },
    "revenue_delta":    { "type": "percent" },

    "ebita":            { "type": "number" },
    "ebita_pct":        { "type": "percent" },
    "ebita_delta":      { "type": "percent" },

    "pwc":              { "type": "percent" },
    "pwc_delta":        { "type": "percent" },
    "pwc_target":       { "type": "percent" },

    "billing":          { "type": "percent" },
    "billing_delta":    { "type": "percent" },
    "billing_target":   { "type": "percent" },

    "gp_emp":           { "type": "number" },
    "gp_emp_idx":       { "type": "number" },
    "gp_emp_delta":     { "type": "percent" },

    "admin":            { "type": "number" },
    "admin_idx":        { "type": "number" },
    "admin_delta":      { "type": "percent" },

    "rex":              { "type": "percent" },

    "converted":        { "type": "number" },
    "converted_ytd":    { "type": "number" },
    "converted_goal":   { "type": "number" }
  }
}
